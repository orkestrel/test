{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["node"],
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": "../../src",
		"outDir": "../../dist/reporter"
	},
	"include": [
		"../../src/reporter/**/*.cts",
		"../../src/reporter/**/*.mts",
		"../../src/reporter/**/*.ts",
		"../../src/reporter/**/*.tsx"
	]
}
